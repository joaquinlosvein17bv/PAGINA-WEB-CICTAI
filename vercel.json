{
  "version": 2,
  "buildCommand": "npm run build && cp -r public/. dist/",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(auth|ponencias|ejes-tematicos|certificados|uploads|users)/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/registro",
      "dest": "/grabar-asistencia.html"
    },
    {
      "src": "/reporte",
      "dest": "/reporte-asistencia.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
