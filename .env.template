# ──────────────────────────────────────────────
# BASE DE DATOS — PostgreSQL (Vercel Neon)
# ──────────────────────────────────────────────
# Reemplazá esta URL con la connection string de tu base de datos.
# Si usás Neon, la obtenés desde tu dashboard: Project → Connect → Prisma / Connection string
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/nombre_db?sslmode=require

# ──────────────────────────────────────────────
# OPCIONAL — Solo si vas a enviar correos
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
MAIL_FROM=noreply@cictai.untels.edu.pe

# ──────────────────────────────────────────────
# GOOGLE DRIVE — Boucher PDFs
# ──────────────────────────────────────────────
# En desarrollo local: también podés usar google-service-account.json en la raíz
GOOGLE_DRIVE_FOLDER_ID=id-de-la-carpeta-en-drive
# En Vercel: configurar como variable de entorno
# GOOGLE_SERVICE_ACCOUNT_JSON={ ... contenido completo del JSON ... }
